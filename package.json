{
  "name": "projectmatch",
  "version": "1.0.0",
  "description": "A CLI tool helping SIWES computer science students find, scope, and prepare to defend their final-year projects.",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "projectmatch": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "siwes",
    "cli",
    "computer-science",
    "project-ideas",
    "final-year-project",
    "student-guide"
  ],
  "author": "Antigravity",
  "license": "MIT",
  "dependencies": {
    "@inquirer/prompts": "^7.3.0",
    "chalk": "^5.4.1",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "tsx": "^4.19.2",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
